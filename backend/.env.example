# Only keep configuration that commonly needs local overrides here.
# Backend basics
MOVIE_SCHEDULER_LOG_LEVEL=debug

# Persistence and business defaults
MOVIE_SCHEDULER_DB_PATH=.runtime/movies.db
MOVIE_SCHEDULER_DEFAULT_CITY_ID=10
MOVIE_SCHEDULER_CITY_MAPPING={"\u5317\u4eac":1,"\u4e0a\u6d77":10}

# Scraping configuration
MOVIE_SCHEDULER_TIMEOUT=60
MOVIE_SCHEDULER_DOUBAN_API_BASE_URL=http://localhost:8085
# Shared limit for all Maoyan HTML navigations; 0.2 QPS means at least 5 seconds between starts.
MOVIE_SCHEDULER_MAOYAN_QPS=0.2
# Optional: browser-copied seed Cookie; runtime browser cookies are reused in memory.
MOVIE_SCHEDULER_MAOYAN_COOKIE=
# Docker uses installed Chromium; local development can select installed Google Chrome with chrome.
MOVIE_SCHEDULER_MAOYAN_BROWSER_CHANNEL=chromium
# Optional: connect Docker to a dedicated headless Chrome on the host.
# Start: uv run --project backend python backend/scripts/run_maoyan_browser.py
# MOVIE_SCHEDULER_MAOYAN_BROWSER_CDP_URL=http://host.docker.internal:9223
# Legacy HTTP header helpers only; headless pages use the browser's native headers.
MOVIE_SCHEDULER_MAOYAN_USER_AGENT=
MOVIE_SCHEDULER_MAOYAN_SEC_CH_UA=
MOVIE_SCHEDULER_MAOYAN_SEC_CH_UA_MOBILE=
MOVIE_SCHEDULER_MAOYAN_SEC_CH_UA_PLATFORM=
MOVIE_SCHEDULER_MAOYAN_ACCEPT=
MOVIE_SCHEDULER_MAOYAN_PRIORITY=

# Service configuration
MOVIE_SCHEDULER_HOST=0.0.0.0
MOVIE_SCHEDULER_PORT=8000
MOVIE_SCHEDULER_CORS_ORIGINS=["*"]
